# Keep pnpm's version pinned to the `packageManager` field in package.json.
manage-package-manager-versions=true

# Workspace-local deps resolve to workspace members rather than the registry.
link-workspace-packages=true
prefer-workspace-packages=true

# This repo intentionally installs multiple PixiJS majors side by side (the
# aliased pixi-v6-* / pixi-v7-* devDependencies) so the build can emit a
# separate release per major. Each alias set's @pixi/* peers therefore resolve
# against a sibling major and report as unmet -- expected here, not a defect.
# Pinned explicitly so a future pnpm default or a global .npmrc can't turn
# these known-acceptable warnings into install failures in CI.
strict-peer-dependencies=false
